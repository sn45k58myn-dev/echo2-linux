#!/bin/sh
# Read-only Linux board discovery. All reported values are enums, booleans or counts.
set -eu
export LC_ALL=C

root=
case $# in
    0) ;;
    2) if [ "$1" != --root ] || [ ! -d "$2" ]; then
           echo "usage: echo2-board [--root ROOT]" >&2; exit 2
       fi
       root=${2%/} ;;
    *) echo "usage: echo2-board [--root ROOT]" >&2; exit 2 ;;
esac

dt=$root/proc/device-tree
[ -d "$dt" ] || dt=$root/sys/firmware/devicetree/base
type_property=$dt/idme/device_type_id/value

dt_contains() {
    [ -f "$1" ] && [ -r "$1" ] &&
        tr '\000' '\n' < "$1" | grep -Fxq "$2"
}

type_is() {
    [ -f "$type_property" ] && [ -r "$type_property" ] &&
        tr '\000' '\n' < "$type_property" | awk -v expected="$1" '
            NR == 1 { match_type = ($0 == expected) }
            NR > 1 && length($0) { match_type = 0 }
            END { exit !match_type }
        '
}

# The running Radar and Biscuit kernels can share a MediaTek compatible string.
# device_type_id is model-wide. Do not read serial, MAC, tokens or calibration.
board=unknown
if dt_contains "$dt/compatible" mediatek,mt8163; then
    if type_is A7WXQPH584YP; then
        board=radar_puffin
    elif type_is A3S5BH2HU6VAYF; then
        board=other
    fi
elif [ -f "$dt/compatible" ] && [ -r "$dt/compatible" ] &&
     tr '\000' '\n' < "$dt/compatible" | grep -q . && ! type_is A7WXQPH584YP; then
    board=other
fi

cards=null
if [ -f "$root/proc/asound/cards" ] && [ -r "$root/proc/asound/cards" ]; then
    cards=$(awk '/^[[:space:]]*[0-9]+[[:space:]]+\[/ { ++n } END { print n+0 }' "$root/proc/asound/cards")
fi
playback=null capture=null speaker=null array=null
if [ -f "$root/proc/asound/pcm" ] && [ -r "$root/proc/asound/pcm" ]; then
    # The direction and substream count are colon-delimited fields after the
    # description. A codec name containing "Playback" alone is insufficient.
    counts=$(awk -F: '
        $1 ~ /^[[:space:]]*[0-9]+-[0-9]+[[:space:]]*$/ {
            split($1, slot, "-")
            out = 0; mic = 0
            for (i = 3; i <= NF; i++) {
                if ($i ~ /^[[:space:]]*playback[[:space:]]+[1-9][0-9]*[[:space:]]*$/) out = 1
                if ($i ~ /^[[:space:]]*capture[[:space:]]+[1-9][0-9]*[[:space:]]*$/) mic = 1
            }
            playback += out; capture += mic
            if (out && slot[2]+0 == 23 && tolower($2) ~ /tlv320aic32x4-hifi/) speaker = 1
            if (mic && slot[2]+0 == 24 && tolower($2) ~ /tlv320aic3101-codec/) array = 1
        }
        END { print playback+0, capture+0, speaker?"true":"false", array?"true":"false" }
    ' "$root/proc/asound/pcm")
    set -- $counts
    playback=$1 capture=$2 speaker=$3 array=$4
fi

# KEY_MUTE 0x71 and KEY_HELP 0x8a (the mapped action button). Kernel modalias
# key lists avoid guessing the native word width of a sysfs capability bitmap.
action=null mute=null
if [ -d "$root/sys/class/input" ]; then
    keys=$(
        for path in "$root"/sys/class/input/input[0-9]*/modalias; do
            [ ! -f "$path" ] || [ ! -r "$path" ] || cat "$path"
        done | awk '
            /^input:[^-]+-e[[:xdigit:],]*k[[:xdigit:],]*r/ {
                sub(/^input:[^-]+-e[[:xdigit:],]*k/, "")
                sub(/r.*/, "")
                list = "," toupper($0) ","
                if (index(list, ",71,")) mute = 1
                if (index(list, ",8A,")) action = 1
            }
            END { print action?"true":"false", mute?"true":"false" }
        '
    )
    set -- $keys
    action=$1 mute=$2
fi

privacy=null
if [ -d "$root/sys/devices/platform" ]; then
    privacy=false
    [ ! -f "$root/sys/devices/platform/amz_privacy/privacy_state" ] || privacy=true
fi
ring=null
if [ -d "$root/sys/bus/i2c/drivers" ]; then
    ring=false
    for path in "$root"/sys/bus/i2c/drivers/is31fl32xx/*-*/frame; do
        if [ -f "$path" ]; then ring=true; break; fi
    done
fi

wlan=null bluetooth=null
if [ -d "$root/sys/class/rfkill" ]; then
    wlan=false bluetooth=false
    for path in "$root"/sys/class/rfkill/rfkill[0-9]*/type; do
        [ -f "$path" ] && [ -r "$path" ] || continue
        case $(cat "$path") in
            wlan) wlan=true ;;
            bluetooth) bluetooth=true ;;
        esac
    done
fi

printf '{"schema":1,"board":"%s",' "$board"
printf '"alsa":{"cards":%s,"playback_devices":%s,"capture_devices":%s,"speaker_pcm":%s,"array_pcm":%s},' \
    "$cards" "$playback" "$capture" "$speaker" "$array"
printf '"input":{"action_key":%s,"mute_key":%s,"privacy_state_interface":%s},' "$action" "$mute" "$privacy"
printf '"ring":{"frame_interface":%s},"rfkill":{"wlan":%s,"bluetooth":%s}}\n' "$ring" "$wlan" "$bluetooth"
